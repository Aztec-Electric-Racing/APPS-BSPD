/stm32f4xx_hal_rcc.c.obj CMakeFiles/APPS-BSPD.elf.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_rcc_ex.c.obj CMakeFiles/APPS-BSPD.elf.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_ll_adc.c.obj CMakeFiles/APPS-BSPD.elf.dir/Drivers/STM32F4xx_HAL_Driver/Src/stm32f4xx_ll_usb.c.obj CMakeFiles/APPS-BSPD.elf.dir/Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Src/usbd_cdc.c.obj CMakeFiles/APPS-BSPD.elf.dir/Middlewares/ST/STM32_USB_Device_Library/Core/Src/usbd_core.c.obj CMakeFiles/APPS-BSPD.elf.dir/Middlewares/ST/STM32_USB_Device_Library/Core/Src/usbd_ctlreq.c.obj CMakeFiles/APPS-BSPD.elf.dir/Middlewares/ST/STM32_USB_Device_Library/Core/Src/usbd_ioreq.c.obj CMakeFiles/APPS-BSPD.elf.dir/USB_DEVICE/App/usb_device.c.obj CMakeFiles/APPS-BSPD.elf.dir/USB_DEVICE/App/usbd_cdc_if.c.obj CMakeFiles/APPS-BSPD.elf.dir/USB_DEVICE/App/usbd_desc.c.obj CMakeFiles/APPS-BSPD.elf.dir/USB_DEVICE/Target/usbd_conf.c.obj CMakeFiles/APPS-BSPD.elf.dir/startup_stm32f446rctx.s.obj
  CONFIG = Debug
  FLAGS = -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -g
  LINK_FLAGS = -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -specs=nano.specs -specs=nosys.specs -T/home/zaina/AER/APPS-BSPD/STM32F446RCTX_FLASH.ld -Wl,--gc-sections -Wl,-Map=/home/zaina/AER/APPS-BSPD/build/APPS-BSPD.map -Wl,--print-memory-usage
  OBJECT_DIR = CMakeFiles/APPS-BSPD.elf.dir
  POST_BUILD = cd /home/zaina/AER/APPS-BSPD/build && arm-none-eabi-objcopy -O ihex /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.elf /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.hex && arm-none-eabi-objcopy -O binary /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.elf /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.bin && arm-none-eabi-size /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.elf
  PRE_LINK = :
  TARGET_FILE = APPS-BSPD.elf
  TARGET_PDB = APPS-BSPD.elf.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/APPS-BSPD.elf.dir


#############################################
# Utility command for flash

build flash: phony CMakeFiles/flash APPS-BSPD.elf


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/zaina/AER/APPS-BSPD/build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/zaina/AER/APPS-BSPD/build && /usr/bin/cmake --regenerate-during-build -S/home/zaina/AER/APPS-BSPD -B/home/zaina/AER/APPS-BSPD/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Custom command for CMakeFiles/flash

build CMakeFiles/flash | ${cmake_ninja_workdir}CMakeFiles/flash: CUSTOM_COMMAND APPS-BSPD.elf || APPS-BSPD.elf
  COMMAND = cd /home/zaina/AER/APPS-BSPD/build && openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c "program /home/zaina/AER/APPS-BSPD/build/APPS-BSPD.elf verify reset exit"
  pool = console

